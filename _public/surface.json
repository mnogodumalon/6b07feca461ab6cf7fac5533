{
  "version": 1,
  "pages": [
    {
      "slug": "feedback-geben",
      "component": "FeedbackGeben",
      "title": "Feedback geben",
      "endpoints": [
        {
          "entity": "interaktionen",
          "op": "list",
          "fields": [
            "frage",
            "erlaeuterung",
            "veranstaltung"
          ],
          "scope": "r.v_aktiv == True",
          "scope_description": "zeigt nur die Interaktion, die gerade aktiv ist",
          "max_records": 1
        },
        {
          "entity": "feedbacks",
          "op": "create",
          "fields": [
            "interaktion",
            "kuerzel",
            "feedback_text",
            "sendekennung"
          ],
          "key_field": "sendekennung"
        }
      ]
    },
    {
      "slug": "abschlussbewertung",
      "component": "Abschlussbewertung",
      "title": "Abschlussbewertung",
      "endpoints": [
        {
          "entity": "veranstaltungen",
          "op": "list",
          "fields": [
            "titel",
            "datum"
          ],
          "max_records": 200
        },
        {
          "entity": "abschlussbewertungen",
          "op": "create",
          "fields": [
            "veranstaltung",
            "kuerzel",
            "besonders_toll",
            "verbesserungen",
            "referenzstatement",
            "email",
            "einwilligung"
          ]
        }
      ]
    }
  ]
}